PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/incidenthub
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h
CLIENT_ORIGIN=http://localhost:5173
# Leave REDIS_URL unset to run without a queue. Escalation waits then stay in this process and are lost on restart.
